new file mode 100644
index 0000000..d673bdd
--- /dev/null
+++ b/envs/robot/cpu_planner.py
@@ -0,0 +1,91 @@
+"""[CPU port] MPlib 0.2.1 CPU replacement for RoboTwin's CuroboPlanner (CuRobo requires CUDA).
+
+Adapted from the RMBench ARM64 port (artifacts/rmbench-arm64-runtime-20261108, envs/robot/cpu_cartesian.py).
+This is an alternative planner, NOT a numerically identical port of CuRobo:
+  * plan_path: MPlib screw interpolation first (straight Cartesian motion), RRTConnect (plan_pose) fallback
+    when no constraint is requested.
+  * Target poses are the end-link poses in the world frame (from Robot._trans_from_gripper_to_endlink);
+    MPlib loads the original URDF with the robot root pose, so CuRobo's yml frame_bias and the
+    aloha-agilex -0.02/-0.01 rad CuRobo calibration rotations are not applied.
+  * Collision world: the robot itself plus one table box mirroring CuRobo's world_config
+    (2 x 0.7 x 0.04 m, center z = 0.74). No point cloud / objects.
+  * CuRobo partial-pose constraints (constraint_pose) are approximated by screw-only planning.
+  * TOPP is MPlib's own TOPP (same as RoboTwin's MplibPlanner.TOPP).
+"""
+import numpy as np
+
+
+class CPUMplibPlanner:
+
+    def __init__(self, urdf_path, srdf_path, move_group, robot_origion_pose, robot_entity):
+        import mplib
+        import toppra as ta
+        from mplib.collision_detection.fcl import Box, FCLObject, CollisionObject
+        from xml.etree import ElementTree as ET
+
+        ta.setup_logging("CRITICAL")
+        self.planner = mplib.Planner(
+            urdf=urdf_path,
+            srdf=srdf_path,
+            move_group=move_group,
+            user_link_names=[link.get_name() for link in robot_entity.get_links()],
+            user_joint_names=[joint.get_name() for joint in robot_entity.get_active_joints()],
+            use_convex=False,
+        )
+        # The shipped SRDF omits some adjacent pairs; ignore collisions between directly joint-connected links.
+        for joint in ET.parse(urdf_path).findall("joint"):
+            self.planner.acm.set_entry(joint.find("parent").attrib["link"], joint.find("child").attrib["link"], True)
+        self.planner.set_base_pose(mplib.Pose(robot_origion_pose.p, robot_origion_pose.q))
+        self.planner.planning_world.add_object(
+            FCLObject("cpu_table", mplib.Pose([0, 0, 0.74], [1, 0, 0, 0]), [CollisionObject(Box(2, 0.7, 0.04))],
+                      [mplib.Pose()]))
+        self.TOPP = self.planner.TOPP
+        self.plan_step_lim = 2500
+
+    @staticmethod
+    def _pose(target_pose):
+        import mplib
+        return mplib.Pose(np.asarray(target_pose.p, dtype=np.float64), np.asarray(target_pose.q, dtype=np.float64))
+
+    def plan_path(self, curr_joint_pos, target_gripper_pose, constraint_pose=None, arms_tag=None, **kwargs):
+        goal = self._pose(target_gripper_pose)
+        qpos = np.asarray(curr_joint_pos, dtype=np.float64)
+        result = self.planner.plan_screw(goal, qpos, time_step=1 / 250)
+        if result["status"] != "Success" and constraint_pose is None:
+            result = self.planner.plan_pose(goal, qpos, time_step=1 / 250, planning_time=2)
+        if result["status"] == "Success" and result["position"].shape[0] > self.plan_step_lim:
+            result = {"status": "Fail"}
+        if result["status"] != "Success":
+            return {"status": "Fail"}
+        return {"status": "Success", "position": result["position"], "velocity": result["velocity"]}
+
+    def plan_batch(self, curr_joint_pos, target_gripper_pose_list, constraint_pose=None, arms_tag=None, **kwargs):
+        results = [self.plan_path(curr_joint_pos, t, constraint_pose, arms_tag) for t in target_gripper_pose_list]
+        status = np.array(["Success" if r["status"] == "Success" else "Failure" for r in results], dtype=object)
+        out = {"status": status}
+        if np.all(status == "Failure"):
+            return out
+        # CuRobo returns equal-length padded trajectories; pad each with its final waypoint.
+        n = max(r["position"].shape[0] for r in results if r["status"] == "Success")
+        dof = next(r["position"].shape[1] for r in results if r["status"] == "Success")
+        pos, vel = [], []
+        for r in results:
+            if r["status"] != "Success":
+                pos.append(np.zeros((n, dof)))
+                vel.append(np.zeros((n, dof)))
+                continue
+            p, v = r["position"], r["velocity"]
+            pad = n - p.shape[0]
+            pos.append(np.concatenate([p, np.repeat(p[-1:], pad, 0)]) if pad else p)
+            vel.append(np.concatenate([v, np.zeros((pad, dof))]) if pad else v)
+        out["position"] = np.stack(pos)
+        out["velocity"] = np.stack(vel)
+        return out
+
+    def plan_grippers(self, now_val, target_val):
+        num_step = 200
+        return {
+            "num_step": num_step,
+            "per_step": (target_val - now_val) / num_step,
+            "result": np.linspace(now_val, target_val, num_step),
+        }
